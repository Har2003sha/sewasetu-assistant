# copy to .env, fill in, then:  docker compose up --build -d
SITE_ADDRESS=1-2-3-4.sslip.io            # your domain (or <vm-ip-with-dashes>.sslip.io); caddy gets the certificate
PUBLIC_BASE_URL=https://1-2-3-4.sslip.io # exactly what people type; stamped into tokens
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SECRET_KEY=change-me-long-random
INTERNAL_API_KEY=change-me-long-random
